# Copy this file to .env and fill in your real key. Never commit .env itself.

# Which provider src/llm.py should use: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=gemini. Get a free key from Google AI Studio.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional overrides -- sensible defaults are already set in src/config.py
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DEFAULT_TOP_K=6
